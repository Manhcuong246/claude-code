# First run: ./start.sh copies this file to .env (if .env is missing).
# You only need to set DEEPSEEK_API_KEY, then run ./start.sh again.

DEEPSEEK_API_KEY=sk-your-key-here

MODEL_OPUS=deepseek/deepseek-reasoner
MODEL_SONNET=deepseek/deepseek-chat
MODEL_HAIKU=deepseek/deepseek-chat
MODEL=deepseek/deepseek-chat

HOST=0.0.0.0
PORT=8082
ANTHROPIC_AUTH_TOKEN=change-me
FCC_ADMIN_ALLOW_REMOTE=true
MESSAGING_PLATFORM=none
LOG_FILE=/data/logs/server.log
