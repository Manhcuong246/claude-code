# Copy to aws.env and fill in values (aws.env is gitignored).
#
# --- Required for your chosen provider(s) ---
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
WAFER_API_KEY=
OPENCODE_API_KEY=
ZAI_API_KEY=

# Router: default model (see root .env.example for format)
MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b

# --- Server ---
# Keep 8082 unless you change the container port in deploy/docker-compose.yml.
HOST=0.0.0.0
PORT=8082

# Same token in Claude Code: ANTHROPIC_AUTH_TOKEN (use a long random string in production)
ANTHROPIC_AUTH_TOKEN=

# "true" = open /admin from browser via http://YOUR_VPS_IP:8082/admin
# Prefer restricting EC2 security group to your IP, or use Tailscale/VPN.
FCC_ADMIN_ALLOW_REMOTE=true

# Bots need extra tokens; disable on a minimal VPS if you only use the HTTP proxy
MESSAGING_PLATFORM=none

# Optional: write logs under persisted volume (/data in container)
LOG_FILE=/data/logs/server.log
